<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextElement.Foreground="#F1F2F4" TextElement.FontFamily="Segoe UI">
  <Grid.Resources>
    <Style x:Key="InputAction" TargetType="Button">
      <Setter Property="Background" Value="#282B33"/><Setter Property="Foreground" Value="#EEF1F7"/>
      <Setter Property="BorderBrush" Value="#414652"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Face" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="Tag" Value="selected"><Setter TargetName="Face" Property="Background" Value="#354D95"/><Setter TargetName="Face" Property="BorderBrush" Value="#6581D8"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#A5B9FF"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#A5B9FF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value=".75"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".40"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MapButton" TargetType="Button" BasedOn="{StaticResource InputAction}">
      <Setter Property="Background" Value="#19212F"/><Setter Property="BorderBrush" Value="#526580"/><Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="MapRound" TargetType="Button" BasedOn="{StaticResource MapButton}">
      <Setter Property="Width" Value="23"/><Setter Property="Height" Value="23"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Ellipse x:Name="Hit" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
          <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Tag" Value="selected"><Setter TargetName="Hit" Property="Fill" Value="#4261A5"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Stroke" Value="#C2D4FF"/><Setter TargetName="Hit" Property="Fill" Value="#2E446C"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hit" Property="Stroke" Value="#C2D4FF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="BindingTile" TargetType="Button" BasedOn="{StaticResource InputAction}">
      <Setter Property="Background" Value="#252A34"/><Setter Property="BorderBrush" Value="#323A47"/>
      <Setter Property="Padding" Value="8,4"/><Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="0,0,0,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Controls" FontWeight="Bold" FontSize="25" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Button x:Name="KeyboardMode" Style="{StaticResource InputAction}" Content="Keyboard &amp; Mouse" Margin="0,0,5,0"/>
      <Button x:Name="ControllerMode" Style="{StaticResource InputAction}" Content="Controller"/>
    </StackPanel>
    <Button x:Name="ResetBindings" Grid.Column="2" Style="{StaticResource InputAction}" Content="Reset defaults" VerticalAlignment="Center"/>
  </Grid>
  <Border Grid.Row="1" Background="#1B202A" BorderBrush="#343D4D" BorderThickness="1" CornerRadius="12" Padding="12,10">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.74*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="LEFT &amp; D-PAD" Foreground="#9CAFE2" FontSize="11" FontWeight="SemiBold" Margin="3,0,0,7"/>
        <StackPanel x:Name="LeftBindings"/>
      </StackPanel>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Viewbox MaxHeight="247" StretchDirection="DownOnly">
          <Canvas Width="394" Height="284">
            <Path Data="M 0,195 H 37 L 59,174 H 83 M 0,232 H 54 L 78,214 H 110 M 394,195 H 360 L 333,174 H 309 M 394,231 H 349 L 321,214 H 292"
                  Stroke="#4D608B" StrokeThickness="1" StrokeDashArray="3 3" Opacity=".75"/>
            <Rectangle Canvas.Left="60" Canvas.Top="7" Width="274" Height="143" RadiusX="17" RadiusY="17" Fill="#182131" Stroke="#637894" StrokeThickness="2"/>
            <Rectangle Canvas.Left="64" Canvas.Top="11" Width="266" Height="133" RadiusX="13" RadiusY="13" Fill="#2A3950"/>
            <Rectangle Canvas.Left="102" Canvas.Top="23" Width="190" Height="114" RadiusX="5" RadiusY="5" Fill="#101724" Stroke="#97A9C5" StrokeThickness="1"/>
            <Rectangle Canvas.Left="107" Canvas.Top="28" Width="180" Height="104" RadiusX="3" RadiusY="3">
              <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#263F62"/><GradientStop Color="#182A43" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
            </Rectangle>
            <Path Data="M 108,28 H 222 L 145,132 H 108 Z" Fill="#15A4CEFF" IsHitTestVisible="False"/>
            <TextBlock Canvas.Left="110" Canvas.Top="41" Width="173" Text="TOP SCREEN" Foreground="#9BAFCE" FontSize="10" TextAlignment="Center"/>
            <TextBlock Canvas.Left="110" Canvas.Top="62" Width="173" Text="YO-KAI 2" Foreground="#CFDEF5" FontSize="26" FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Canvas.Left="110" Canvas.Top="95" Width="173" Text="CONTROL MAP" Foreground="#A3BBE4" FontSize="10" TextAlignment="Center"/>
            <Path Data="M 75,58 h 13 m -13,5 h 13 m -13,5 h 13 m 218,-10 h 13 m -13,5 h 13 m -13,5 h 13" Stroke="#6F849F" StrokeThickness="1.3"/>
            <Ellipse Canvas.Left="194" Canvas.Top="15" Width="5" Height="5" Fill="#101724" Stroke="#546986" StrokeThickness="1"/>
            <Rectangle Canvas.Left="61" Canvas.Top="145" Width="272" Height="17" RadiusX="8" RadiusY="8" Fill="#111822" Stroke="#617894"/>
            <Rectangle Canvas.Left="110" Canvas.Top="148" Width="174" Height="10" RadiusX="5" RadiusY="5" Fill="#40546C"/>
            <Rectangle Canvas.Left="60" Canvas.Top="161" Width="274" Height="118" RadiusX="16" RadiusY="16" Fill="#172131" Stroke="#637894" StrokeThickness="2"/>
            <Rectangle Canvas.Left="64" Canvas.Top="164" Width="266" Height="111" RadiusX="13" RadiusY="13" Fill="#31415A"/>
            <Rectangle Canvas.Left="123" Canvas.Top="171" Width="138" Height="84" RadiusX="5" RadiusY="5" Fill="#111725" Stroke="#8B9DB9"/>
            <Rectangle Canvas.Left="127" Canvas.Top="175" Width="130" Height="76" RadiusX="3" RadiusY="3" Fill="#20324B"/>
            <Path Data="M 145,193 H 239 M 145,228 H 239 M 145,193 V 228 M 239,193 V 228" Stroke="#5B779D" StrokeThickness="1" StrokeDashArray="2 4"/>
            <TextBlock Canvas.Left="129" Canvas.Top="205" Width="126" Text="TOUCH SCREEN" Foreground="#ADBFD9" FontSize="9" TextAlignment="Center"/>
            <Button x:Name="HitZL" Canvas.Left="64" Canvas.Top="112" Width="28" Height="18" Style="{StaticResource MapButton}" Content="ZL"/>
            <Button x:Name="HitZR" Canvas.Left="302" Canvas.Top="112" Width="28" Height="18" Style="{StaticResource MapButton}" Content="ZR"/>
            <Button x:Name="HitL" Canvas.Left="54" Canvas.Top="146" Width="39" Height="19" Style="{StaticResource MapButton}" Content="L"/>
            <Button x:Name="HitR" Canvas.Left="301" Canvas.Top="146" Width="39" Height="19" Style="{StaticResource MapButton}" Content="R"/>
            <Ellipse Canvas.Left="76" Canvas.Top="171" Width="37" Height="37" Fill="#7D8BA0" Stroke="#BAC7DB" StrokeThickness="1.4"/>
            <Ellipse Canvas.Left="79" Canvas.Top="174" Width="31" Height="31" Fill="#8F9FB5" Stroke="#697D98" StrokeThickness="1"/>
            <Button x:Name="HitUp" Canvas.Left="87" Canvas.Top="209" Width="15" Height="15" Style="{StaticResource MapButton}" Content="↑" FontSize="9"/>
            <Button x:Name="HitDown" Canvas.Left="87" Canvas.Top="238" Width="15" Height="15" Style="{StaticResource MapButton}" Content="↓" FontSize="9"/>
            <Button x:Name="HitLeft" Canvas.Left="72" Canvas.Top="223" Width="15" Height="15" Style="{StaticResource MapButton}" Content="←" FontSize="9"/>
            <Button x:Name="HitRight" Canvas.Left="102" Canvas.Top="223" Width="15" Height="15" Style="{StaticResource MapButton}" Content="→" FontSize="9"/>
            <Rectangle Canvas.Left="87" Canvas.Top="224" Width="15" Height="14" RadiusX="2" RadiusY="2" Fill="#24344B"/>
            <Button x:Name="HitX" Canvas.Left="286" Canvas.Top="172" Style="{StaticResource MapRound}" Content="X"/>
            <Button x:Name="HitY" Canvas.Left="265" Canvas.Top="193" Style="{StaticResource MapRound}" Content="Y"/>
            <Button x:Name="HitA" Canvas.Left="307" Canvas.Top="193" Style="{StaticResource MapRound}" Content="A"/>
            <Button x:Name="HitB" Canvas.Left="286" Canvas.Top="214" Style="{StaticResource MapRound}" Content="B"/>
            <Button x:Name="HitSelect" Canvas.Left="264" Canvas.Top="249" Width="25" Height="16" Style="{StaticResource MapButton}" Content="SEL" FontSize="8"/>
            <Button x:Name="HitStart" Canvas.Left="298" Canvas.Top="249" Width="27" Height="16" Style="{StaticResource MapButton}" Content="START" FontSize="7.5"/>
            <Rectangle Canvas.Left="182" Canvas.Top="261" Width="30" Height="9" RadiusX="4" RadiusY="4" Fill="#182232" Stroke="#536884"/>
          </Canvas>
        </Viewbox>
        <StackPanel Grid.Row="1" Margin="13,3,13,0" HorizontalAlignment="Stretch">
          <TextBlock Text="CIRCLE PAD" Foreground="#B1C6EC" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,3"/>
          <UniformGrid x:Name="CircleBindings" Rows="1" Columns="4"/>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Column="2">
        <TextBlock Text="RIGHT &amp; ACTION" Foreground="#A6C9C5" FontSize="11" FontWeight="SemiBold" Margin="3,0,0,7"/>
        <StackPanel x:Name="RightBindings"/>
      </StackPanel>
    </Grid>
  </Border>
  <Grid Grid.Row="2" Margin="0,9,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="CaptureStatus" Text="Click a mapping or a button on the 3DS to change its binding." Foreground="#D2DDF7" TextWrapping="Wrap"/>
    <StackPanel x:Name="CaptureActions" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" HorizontalAlignment="Right" Visibility="Collapsed">
      <ComboBox x:Name="PadChoice" Width="162" Height="30" Visibility="Collapsed" ToolTip="Choose a controller button manually"/>
      <Button x:Name="Unbind" Style="{StaticResource InputAction}" Content="Unbind" Margin="6,0,0,0"/>
      <Button x:Name="CancelCapture" Style="{StaticResource InputAction}" Content="Cancel" Margin="6,0,0,0"/>
    </StackPanel>
    <TextBlock x:Name="ModeHint" Grid.Row="1" Grid.ColumnSpan="2" Foreground="#A1ACBD" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
  </Grid>
</Grid>
