<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yo-kai Watch 2 Recompiled" Width="960" Height="650" MinWidth="780" MinHeight="535"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#121315" Foreground="#F1F2F4" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#F1F2F4"/>
    <SolidColorBrush x:Key="Muted" Color="#A7AAB2"/>
    <SolidColorBrush x:Key="Line" Color="#33353C"/>
    <SolidColorBrush x:Key="Panel" Color="#23252A"/>
    <SolidColorBrush x:Key="Blue" Color="#4162DC"/>
    <SolidColorBrush x:Key="Green" Color="#72BE9C"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#282A31"/>
      <Setter Property="BorderBrush" Value="#41444D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CaretBrush" Value="#F1F2F4"/>
      <Setter Property="SelectionBrush" Value="#4162DC"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="29"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="15,11"/>
    </Style>
    <Style x:Key="Button" TargetType="Button">
      <Setter Property="Background" Value="#25272D"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="#393B43"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Face" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#868DA3"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#A7B9FF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value=".80"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".46"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Button}">
      <Setter Property="Background" Value="{StaticResource Blue}"/><Setter Property="BorderBrush" Value="#5673E4"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="Play" TargetType="Button" BasedOn="{StaticResource Button}">
      <Setter Property="Background" Value="{StaticResource Green}"/><Setter Property="BorderBrush" Value="#8AD1AF"/>
      <Setter Property="Foreground" Value="#0D2119"/><Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource Button}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#B8C8FA"/><Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style x:Key="Chrome" TargetType="Button" BasedOn="{StaticResource Button}">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
      <Setter Property="Background" Value="#23252B"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="3,0,0,0"/>
      <Setter Property="Foreground" Value="#C6C9D1"/>
    </Style>
    <Style x:Key="Step" TargetType="Border">
      <Setter Property="Padding" Value="11,6"/><Setter Property="CornerRadius" Value="14"/>
      <Style.Triggers>
        <Trigger Property="Tag" Value="active"><Setter Property="Background" Value="#2F3C68"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Face" Background="#25272D" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Face" Property="Background" Value="#394773"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#C1CFFF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="ChoiceFace" CornerRadius="7" Background="#282A31" BorderBrush="#41444D" BorderThickness="1">
                <Path Data="M0,0 L4,4 8,0" Stroke="#A7AAB2" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceFace" Property="BorderBrush" Value="#828AA2"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,25,0" Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False"
                 PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
            <Border Background="#25272D" BorderBrush="#454955" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0">
              <ScrollViewer MaxHeight="220" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" Background="Transparent">
          <Border x:Name="Box" Width="17" Height="17" CornerRadius="4" Background="#202228" BorderBrush="#696E7A" BorderThickness="1" Margin="0,0,10,0">
            <Path x:Name="Tick" Data="M3,7 L6,10 12,4" Visibility="Collapsed" Stroke="White" StrokeThickness="1.8"/>
          </Border>
          <ContentPresenter VerticalAlignment="Center"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Blue}"/><Setter TargetName="Box" Property="BorderBrush" Value="#6684F1"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#AFBFFF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".50"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border CornerRadius="13" BorderBrush="#2B2D33" BorderThickness="1">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1B1D23"/><GradientStop Color="#141518" Offset="1"/></LinearGradientBrush></Border.Background>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border x:Name="TitleBar" Background="Transparent" Padding="28,0,20,0">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False">
            <Image x:Name="TitleIcon" Width="21" Height="21" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Yo-kai Watch 2 Recompiled" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="HeaderVersion" Text="V1.0.0" Style="{StaticResource Hint}" FontSize="11" Margin="8,1,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <Border x:Name="Steps" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#202228" BorderBrush="#30323A" BorderThickness="1" CornerRadius="18" Padding="3" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="RomStep" Style="{StaticResource Step}"><TextBlock x:Name="RomStepLabel" Text="1  Game file"/></Border>
              <Border x:Name="OptionsStep" Style="{StaticResource Step}"><TextBlock x:Name="OptionsStepLabel" Text="2  Options"/></Border>
              <Border x:Name="CompileStep" Style="{StaticResource Step}"><TextBlock x:Name="CompileStepLabel" Text="3  Build"/></Border>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button x:Name="SettingsButton" Style="{StaticResource Chrome}" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" ToolTip="Settings"/>
            <Button x:Name="MinButton" Style="{StaticResource Chrome}" Content="–" FontSize="16"/>
            <Button x:Name="CloseButton" Style="{StaticResource Chrome}" Content="×" FontSize="18"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="63,0,63,26">
        <Grid x:Name="HomePage">
          <StackPanel x:Name="WelcomePane" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Image x:Name="WelcomeIcon" Width="105" Height="112" Margin="0,0,0,22" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="WelcomeTitle" Style="{StaticResource Heading}" Text="Build your game" TextAlignment="Center"/>
            <TextBlock x:Name="WelcomeDescription" Style="{StaticResource Hint}" Text="Turn your own European copy of Yo-kai Watch 2: Psychic Specters into a native PC game." TextAlignment="Center" MaxWidth="430" Margin="0,8,0,23"/>
            <Button x:Name="SetupButton" Style="{StaticResource Primary}" Content="Set up the game" Width="190" Height="49" HorizontalAlignment="Center" FontSize="16"/>
            <Button x:Name="LinkGameButton" Style="{StaticResource Link}" Content="Locate an existing build" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            <TextBlock x:Name="WelcomeNote" Style="{StaticResource Hint}" Text="Your ROM and saves stay on this PC." FontSize="12" TextAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
          <Grid x:Name="ReadyPane" VerticalAlignment="Center" Margin="0,0,0,17" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width=".88*"/><ColumnDefinition Width="37"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12"><TextBlock Text="Yo-kai Watch 2" Style="{StaticResource Heading}" FontSize="34"/><TextBlock Text="Psychic Specters" FontSize="21" FontWeight="SemiBold" Foreground="#B8C8FA"/></StackPanel>
            <StackPanel Grid.Row="1">
              <TextBlock x:Name="StatusTitle" Text="Ready to play" FontWeight="SemiBold" FontSize="16"/>
              <TextBlock x:Name="StatusDetail" Style="{StaticResource Hint}" Text="Native PC port · Windows x64" Margin="0,3,0,15"/>
            </StackPanel>
            <DockPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,6">
              <Button x:Name="NewBuildButton" DockPanel.Dock="Right" Style="{StaticResource Link}" Content="+  New build"/>
              <TextBlock x:Name="InstallationLabel" Text="INSTALLATION" Style="{StaticResource Hint}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
            <Button x:Name="SavesButton" Grid.Row="2" Style="{StaticResource Button}" Content="Save files  ›" HorizontalContentAlignment="Left" MinHeight="60"/>
            <Border x:Name="InstallationCard" Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="✓" Foreground="{StaticResource Green}" FontSize="19" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="InstallTitle" Text="Yo-kai Watch 2: Psychic Specters" FontWeight="SemiBold"/>
                  <TextBlock x:Name="InstallDetail" Text="Local installation" Style="{StaticResource Hint}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,17,0,0">
              <Button x:Name="PlayButton" Style="{StaticResource Play}" Content="▶  Play" Width="132" Height="48" FontSize="16"/>
              <Button x:Name="PlaySettingsButton" Style="{StaticResource Button}" Height="48" Margin="9,0,0,0" Padding="13,0"
                      AutomationProperties.Name="Settings">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <TextBlock Text="Settings" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <Button x:Name="InstallFolderButton" Grid.Row="3" Grid.Column="2" Style="{StaticResource Link}" Content="Open game folder  ↗"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0"/>
          </Grid>
          <StackPanel x:Name="RebuildPane" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <Image x:Name="RebuildIcon" Width="77" Height="83" Margin="0,0,0,19" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Rebuild required" Style="{StaticResource Heading}" TextAlignment="Center"/>
            <TextBlock x:Name="RebuildDetail" Text="Your launcher is up to date. Rebuild the game from your ROM to get the latest fixes."
                       Style="{StaticResource Hint}" TextAlignment="Center" MaxWidth="425" Margin="0,8,0,22"/>
            <Button x:Name="RebuildButton" Style="{StaticResource Primary}" Content="Rebuild game" Width="171" Height="48" HorizontalAlignment="Center"/>
            <TextBlock Text="Your saves will be kept." Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,11,0,0"/>
          </StackPanel>
        </Grid>
        <Grid x:Name="WizardShell" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
          <ScrollViewer x:Name="RomPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,8,0,0">
              <TextBlock x:Name="RomTitle" Style="{StaticResource Heading}" Text="Your game file"/>
              <TextBlock x:Name="RomLabel" Style="{StaticResource Hint}" Text="Select your decrypted European ROM. The file stays on this PC." Margin="0,6,0,21"/>
              <Border x:Name="RomDropZone" Style="{StaticResource Card}" Padding="18,15">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="RomPathText" Text="No ROM selected" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RomHelp" Style="{StaticResource Hint}" Text="Drop a file here or browse your folders." FontSize="13" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource Button}" Content="Browse…"/>
                </Grid>
              </Border>
              <TextBlock Text=".3ds, .cci, .cxi, .cia  ·  CTR-P-BYSP (EUR)" Style="{StaticResource Hint}" FontSize="12" Margin="2,8,0,0"/>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="OptionsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,8,0,0">
              <TextBlock x:Name="OptionsTitle" Text="Installation options" Style="{StaticResource Heading}"/>
              <TextBlock x:Name="OptionsIntro" Text="Choose an original game language. You can change this later in Settings." Style="{StaticResource Hint}" Margin="0,6,0,21"/>
              <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <DockPanel><ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="188"/>
                  <TextBlock x:Name="GameLanguageLabel" Text="Game language" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="PacksTitle" Text="Local assets" FontWeight="SemiBold" Margin="0,0,0,10"/>
                  <TextBlock Style="{StaticResource Hint}" Text="The game will use the original textures from your own cartridge. You can install compatible texture and RomFS mods later."/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="CompilePage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,8,0,0">
              <TextBlock x:Name="CompileTitle" Text="Build the game" Style="{StaticResource Heading}"/>
              <TextBlock x:Name="CompileIntro" Text="The first build prepares its tools automatically. Keep this window open." Style="{StaticResource Hint}" Margin="0,6,0,21"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="BuildSummary" Text="Installation summary" FontWeight="SemiBold"/>
                  <TextBlock x:Name="BuildSelection" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,5,0,13"/>
                  <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="6" Foreground="{StaticResource Green}" Background="#393B42" BorderThickness="0"/>
                  <TextBlock x:Name="BuildStatus" Text="Ready to build." Style="{StaticResource Hint}" Margin="0,9,0,1"/>
                </StackPanel>
              </Border>
              <Button x:Name="CompileLogButton" Style="{StaticResource Link}" Content="View build log" HorizontalAlignment="Right" Margin="0,7,0,0"/>
            </StackPanel>
          </ScrollViewer>
          <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,13,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="WizardBack" Style="{StaticResource Button}" Content="Back" Margin="0,0,8,0"/>
              <Button x:Name="WizardNext" Style="{StaticResource Primary}" Content="Next" MinWidth="86"/>
              <Button x:Name="BuildButton" Style="{StaticResource Primary}" Content="Build" MinWidth="106" Visibility="Collapsed"/>
            </StackPanel>
            <TextBlock x:Name="WizardNote" Style="{StaticResource Hint}" Text="Choose a file to continue." FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
          </DockPanel>
        </Grid>
        <Grid x:Name="SettingsShell" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel LastChildFill="True" Margin="0,2,0,12">
            <Button x:Name="SettingsBack" DockPanel.Dock="Right" Style="{StaticResource Button}" Content="Done"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="GraphicsNav" Style="{StaticResource Link}" Content="Graphics" Margin="0,0,4,0"/>
              <Button x:Name="DisplayNav" Style="{StaticResource Link}" Content="Display" Margin="0,0,4,0"/>
              <Button x:Name="PerformanceNav" Style="{StaticResource Link}" Content="Performance" Margin="0,0,4,0"/>
              <Button x:Name="ControlsNav" Style="{StaticResource Link}" Content="Controls" Margin="0,0,4,0"/>
              <Button x:Name="AudioNav" Style="{StaticResource Link}" Content="Audio" Margin="0,0,4,0"/>
              <Button x:Name="ModsNav" Style="{StaticResource Link}" Content="Mods" Margin="0,0,4,0"/>
              <Button x:Name="MaintenanceNav" Style="{StaticResource Link}" Content="Maintenance" Margin="0,0,4,0"/>
              <Button x:Name="LogNav" Style="{StaticResource Link}" Content="Log"/>
            </StackPanel>
          </DockPanel>
          <ScrollViewer x:Name="GraphicsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock x:Name="GraphicsTitle" Text="Settings" Style="{StaticResource Heading}" FontSize="25"/>
              <TextBlock x:Name="GraphicsNote" Text="Settings apply on the next launch." Style="{StaticResource Hint}" Margin="0,4,0,13"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,6"><ComboBox x:Name="SettingsLanguage" Width="196" DockPanel.Dock="Right"/><TextBlock Text="Game language" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                  <DockPanel Margin="0,0,0,6"><ComboBox x:Name="BackendBox" Width="196" DockPanel.Dock="Right"/><TextBlock Text="Renderer" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                  <DockPanel Margin="0,0,0,6"><ComboBox x:Name="GpuBox" Width="196" DockPanel.Dock="Right"/><TextBlock Text="GPU preference" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                  <DockPanel Margin="0,0,0,6"><ComboBox x:Name="FpsBox" Width="196" DockPanel.Dock="Right"/><TextBlock x:Name="FpsLabel" Text="Frame rate" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                  <DockPanel Margin="0,0,0,6"><ComboBox x:Name="ScaleBox" Width="196" DockPanel.Dock="Right"/><TextBlock Text="Upscaling" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                  <DockPanel x:Name="CustomScaleRow" Visibility="Collapsed" Margin="0,0,0,6"><TextBox x:Name="CustomScale" Width="196" DockPanel.Dock="Right" Padding="5"/><TextBlock Text="Custom internal multiplier (1–10)" VerticalAlignment="Center"/></DockPanel>
                  <DockPanel Margin="0,0,0,6"><ComboBox x:Name="TextureBox" Width="196" DockPanel.Dock="Right"/><TextBlock x:Name="TexturesLabel" Text="Display filtering" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                  <DockPanel Margin="0,0,0,6"><ComboBox x:Name="SamplingBox" Width="196" DockPanel.Dock="Right"/><TextBlock Text="Texture sampling (Vulkan)" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                  <DockPanel Margin="0,0,0,6"><CheckBox x:Name="FxaaCheck" DockPanel.Dock="Right" Content="Enabled" Width="196"/><TextBlock Text="FXAA (top screen, Vulkan)" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                  <DockPanel Margin="0,0,0,6"><Slider x:Name="SharpnessSlider" Width="196" DockPanel.Dock="Right" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/><TextBlock Text="Sharpening (%)" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                  <DockPanel Margin="0,0,0,6"><Slider x:Name="HudSlider" Width="196" DockPanel.Dock="Right" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/><TextBlock Text="HUD size (%)" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                  <DockPanel Margin="0,0,0,6"><Slider x:Name="ZoomSlider" Width="196" DockPanel.Dock="Right" Minimum="60" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/><TextBlock Text="Widescreen camera zoom (%)" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox x:Name="VsyncCheck" Content="VSync"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock x:Name="UpdateCheckNote" Style="{StaticResource Hint}" FontSize="12" Margin="0,13,0,0"/>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="PerformancePage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Performance" Style="{StaticResource Heading}" FontSize="25"/>
              <TextBlock Text="Manage renderer resources without changing the game's original timing." Style="{StaticResource Hint}" Margin="0,4,0,13"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <DockPanel Margin="0,0,0,8"><ComboBox x:Name="ProfileBox" Width="220" DockPanel.Dock="Right"/><TextBlock Text="Resource profile" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                <TextBlock Text="Economy limits worker threads and upload buffers. Performance and Maximum allow higher resource usage." Style="{StaticResource Hint}" Margin="0,0,0,15"/>
                <CheckBox x:Name="PrewarmCheck" Content="Prewarm known graphics pipelines" Margin="0,0,0,12"/>
                <CheckBox x:Name="StatsCheck" Content="Show display FPS and guest VBlank rate (F4)"/>
              </StackPanel></Border>
              <TextBlock Text="Original mode preserves the game's presentation cadence. 60 FPS interpolation targets 60 displayed frames per second; it does not accelerate gameplay." Style="{StaticResource Hint}" Margin="0,12,0,0"/>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="DisplayPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Display" Style="{StaticResource Heading}" FontSize="25"/>
              <TextBlock Text="Choose how the original upper and touch screens appear. Every layout preserves the screens' proportions." Style="{StaticResource Hint}" Margin="0,4,0,13"/>
              <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel>
                <TextBlock Text="WINDOW &amp; ASPECT" Foreground="#B8C8FA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,6"><ComboBox x:Name="AspectBox" Width="220" DockPanel.Dock="Right"/><TextBlock Text="Upper-screen aspect ratio" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                <DockPanel x:Name="CustomAspectRow" Visibility="Collapsed" Margin="0,0,0,6"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBox x:Name="AspectNumerator" Width="95" Padding="5"/><TextBlock Text=":" Margin="7,0" VerticalAlignment="Center"/><TextBox x:Name="AspectDenominator" Width="95" Padding="5"/></StackPanel><TextBlock Text="Custom aspect (5:4 to 32:9)" VerticalAlignment="Center"/></DockPanel>
                <DockPanel Margin="0,0,0,6"><ComboBox x:Name="WindowResolution" Width="220" DockPanel.Dock="Right"/><TextBlock Text="Window / fullscreen resolution" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                <DockPanel x:Name="CustomWindowRow" Visibility="Collapsed" Margin="0,0,0,6"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBox x:Name="WindowWidth" Width="95" Padding="5"/><TextBlock Text="×" Margin="7,0" VerticalAlignment="Center"/><TextBox x:Name="WindowHeight" Width="95" Padding="5"/></StackPanel><TextBlock Text="Custom window dimensions" VerticalAlignment="Center"/></DockPanel>
                <DockPanel Margin="0,0,0,6"><ComboBox x:Name="WindowModeBox" Width="220" DockPanel.Dock="Right"/><TextBlock Text="Window mode" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                <DockPanel><ComboBox x:Name="MainDisplayBox" Width="220" DockPanel.Dock="Right"/><TextBlock Text="Main monitor" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel>
                <TextBlock Text="SCREEN LAYOUT" Foreground="#B8C8FA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,6"><ComboBox x:Name="LayoutBox" Width="220" DockPanel.Dock="Right"/><TextBlock Text="Layout" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                <StackPanel x:Name="DetachedOptions" Visibility="Collapsed" Margin="0,4,0,6">
                  <DockPanel Margin="0,0,0,8"><ComboBox x:Name="DetachedDisplayBox" Width="220" DockPanel.Dock="Right"/><TextBlock Text="Second-screen monitor" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                  <CheckBox x:Name="DetachedFullCheck" Content="Second screen borderless fullscreen"/>
                </StackPanel>
                <DockPanel Margin="0,0,0,8"><Slider x:Name="TopSize" Width="220" DockPanel.Dock="Right" Minimum="25" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/><TextBlock Text="Upper screen size (%)" FontWeight="SemiBold"/></DockPanel>
                <DockPanel Margin="0,0,0,8"><Slider x:Name="BottomSize" Width="220" DockPanel.Dock="Right" Minimum="25" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/><TextBlock Text="Touch screen size (%)" FontWeight="SemiBold"/></DockPanel>
                <DockPanel Margin="0,0,0,8"><Slider x:Name="ScreenGap" Width="220" DockPanel.Dock="Right" Minimum="0" Maximum="200" TickFrequency="4" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/><TextBlock Text="Spacing (native pixels)" FontWeight="SemiBold"/></DockPanel>
                <StackPanel x:Name="CustomLayoutOptions" Visibility="Collapsed" Margin="0,4,0,8">
                  <DockPanel Margin="0,0,0,6"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBox x:Name="CustomTopX" Width="95" Padding="5"/><TextBlock Text="," Margin="7,0"/><TextBox x:Name="CustomTopY" Width="95" Padding="5"/></StackPanel><TextBlock Text="Upper-screen X, Y" VerticalAlignment="Center"/></DockPanel>
                  <DockPanel Margin="0,0,0,6"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBox x:Name="CustomBottomX" Width="95" Padding="5"/><TextBlock Text="," Margin="7,0"/><TextBox x:Name="CustomBottomY" Width="95" Padding="5"/></StackPanel><TextBlock Text="Touch-screen X, Y" VerticalAlignment="Center"/></DockPanel>
                </StackPanel>
                <DockPanel><TextBox x:Name="BackgroundRgb" Width="220" DockPanel.Dock="Right" Padding="5" MaxLength="7"/><TextBlock Text="Background color (hex RRGGBB)" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" x:Name="PipOptions"><StackPanel>
                <TextBlock Text="PICTURE-IN-PICTURE" Foreground="#B8C8FA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,9"/>
                <DockPanel Margin="0,0,0,8"><Slider x:Name="PipSize" Width="220" DockPanel.Dock="Right" Minimum="15" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/><TextBlock Text="Inset size (%)" FontWeight="SemiBold"/></DockPanel>
                <DockPanel Margin="0,0,0,8"><Slider x:Name="PipX" Width="220" DockPanel.Dock="Right" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/><TextBlock Text="Horizontal position" FontWeight="SemiBold"/></DockPanel>
                <DockPanel Margin="0,0,0,8"><Slider x:Name="PipY" Width="220" DockPanel.Dock="Right" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/><TextBlock Text="Vertical position" FontWeight="SemiBold"/></DockPanel>
                <DockPanel><Slider x:Name="PipOpacity" Width="220" DockPanel.Dock="Right" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/><TextBlock Text="Opacity (%)" FontWeight="SemiBold"/></DockPanel>
              </StackPanel></Border>
              <TextBlock Text="Tab / R3 swaps screens · F7 cycles aspect · F9 toggles one screen · F11 fullscreen. Separate window: F3 hides or restores it. Ultra-wide camera views are experimental." Style="{StaticResource Hint}" Margin="0,12,0,0"/>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="ControlsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
              <ContentControl x:Name="ControlHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"/>
              <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
                <DockPanel Margin="0,0,0,8"><Slider x:Name="DeadzoneSlider" Width="196" DockPanel.Dock="Right" Minimum="0" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Text="Circle Pad dead zone (%)" FontWeight="SemiBold"/></DockPanel>
                <DockPanel><Slider x:Name="SensitivitySlider" Width="196" DockPanel.Dock="Right" Minimum="50" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"/><TextBlock Text="Circle Pad sensitivity (%)" FontWeight="SemiBold"/></DockPanel>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
                <TextBlock Text="CONTROL PROFILES" Foreground="#B8C8FA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,9"/>
                <DockPanel Margin="0,0,0,8">
                  <Button x:Name="LoadControlProfile" Style="{StaticResource Button}" Content="Load" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                  <ComboBox x:Name="ControlProfileBox" Width="210" DockPanel.Dock="Right"/>
                  <TextBlock Text="Saved profile" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel>
                  <Button x:Name="SaveControlProfile" Style="{StaticResource Button}" Content="Save" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                  <TextBox x:Name="ControlProfileName" Width="210" Padding="6" MaxLength="48" DockPanel.Dock="Right"/>
                  <TextBlock Text="Save current controls as" VerticalAlignment="Center"/>
                </DockPanel>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="AudioPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Audio" Style="{StaticResource Heading}" FontSize="25"/>
              <TextBlock Text="Original audio playback, with host device and latency controls." Style="{StaticResource Hint}" Margin="0,4,0,13"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <DockPanel Margin="0,0,0,12"><Slider x:Name="VolumeSlider" Width="196" DockPanel.Dock="Right" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/><TextBlock Text="Master volume (%)" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                <DockPanel Margin="0,0,0,12"><ComboBox x:Name="LatencyBox" Width="196" DockPanel.Dock="Right"/><TextBlock Text="Audio latency" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                <DockPanel Margin="0,0,0,5"><ComboBox x:Name="AudioDevice" Width="310" DockPanel.Dock="Right"/><TextBlock Text="Playback device" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                <TextBlock x:Name="AudioDeviceNote" Text="Playback device selection applies at the next launch." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <CheckBox x:Name="MonoCheck" Content="Mono audio" Margin="0,3,0,10"/><CheckBox x:Name="MuteCheck" Content="Mute in background"/>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="ModsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Mods" Style="{StaticResource Heading}" FontSize="25"/>
              <TextBlock Text="Local mods modifying RomFS, Level-5 archive files or textures. Original data is never overwritten." Style="{StaticResource Hint}" Margin="0,4,0,13"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Installed local mods · lowest priority first" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ListBox x:Name="ModList" MinHeight="110" Background="#181A20" Foreground="#F1F2F4" BorderBrush="#393B43"/>
                <WrapPanel Margin="0,10,0,0">
                  <Button x:Name="OpenModsButton" Style="{StaticResource Button}" Content="Open mods folder" Margin="0,0,8,8"/>
                  <Button x:Name="ToggleModButton" Style="{StaticResource Button}" Content="Enable / Disable" Margin="0,0,8,8"/>
                  <Button x:Name="ModUp" Style="{StaticResource Button}" Content="Move up" Margin="0,0,8,8"/>
                  <Button x:Name="ModDown" Style="{StaticResource Button}" Content="Move down" Margin="0,0,8,8"/>
                  <Button x:Name="ModConflict" Style="{StaticResource Button}" Content="Check conflicts" Margin="0,0,8,8"/>
                  <Button x:Name="ModOriginal" Style="{StaticResource Button}" Content="Restore original" Margin="0,0,8,8"/>
                </WrapPanel>
                <CheckBox x:Name="RegionalModCheck" Content="Enable EUR-specific RomFS replacements" Margin="0,6,0,0"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
                <TextBlock Text="MOD PROFILES" Foreground="#B8C8FA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,9"/>
                <DockPanel Margin="0,0,0,8"><Button x:Name="ModProfileLoad" Style="{StaticResource Button}" Content="Load" DockPanel.Dock="Right" Margin="8,0,0,0"/><ComboBox x:Name="ModProfileBox" Width="210" DockPanel.Dock="Right"/><TextBlock Text="Saved mod profile" VerticalAlignment="Center"/></DockPanel>
                <DockPanel><Button x:Name="ModProfileSave" Style="{StaticResource Button}" Content="Save" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="ModProfileName" Width="210" Padding="6" MaxLength="48" DockPanel.Dock="Right"/><TextBlock Text="Save current load order and enabled mods as" VerticalAlignment="Center"/></DockPanel>
              </StackPanel></Border>
              <TextBlock Text="Mods are applied the next time you start the game. Use only packs compatible with Psychic Specters Europe." Style="{StaticResource Hint}" Margin="0,12,0,0"/>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="MaintenancePage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Maintenance" Style="{StaticResource Heading}" FontSize="25"/>
              <TextBlock Text="Check your cartridge, repair the local build, and protect your saves." Style="{StaticResource Hint}" Margin="0,4,0,13"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <Button x:Name="VerifyButton" Style="{StaticResource Button}" Content="Verify game files" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                <Button x:Name="RepairButton" Style="{StaticResource Button}" Content="Rebuild / repair game" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                <Button x:Name="BackupButton" Style="{StaticResource Button}" Content="Create save backup" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                <Button x:Name="ExportSaveButton" Style="{StaticResource Button}" Content="Export Diary" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                <Button x:Name="ImportSaveButton" Style="{StaticResource Button}" Content="Import decrypted Diary" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                <Button x:Name="CacheResetButton" Style="{StaticResource Button}" Content="Reset graphics caches" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                <Button x:Name="ExportLogsButton" Style="{StaticResource Button}" Content="Export logs" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                <Button x:Name="DiagnosticButton" Style="{StaticResource Button}" Content="Export diagnostic report" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                <Button x:Name="ResetButton" Style="{StaticResource Button}" Content="Restore default settings" HorizontalContentAlignment="Left"/>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
          <Grid x:Name="LogPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/><RowDefinition Height="53"/></Grid.RowDefinitions>
            <TextBlock x:Name="LogTitle" Text="Build log" Style="{StaticResource Heading}" FontSize="25"/>
            <TextBox x:Name="JournalText" Grid.Row="1" IsReadOnly="True" Background="#111217" Foreground="#D5D7DF"
                     BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10" FontFamily="Consolas" FontSize="12"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
              <Button x:Name="OpenFolderButton" Style="{StaticResource Button}" Content="Launcher folder" Margin="0,0,8,0"/>
              <Button x:Name="CopyLogButton" Style="{StaticResource Button}" Content="Copy log"/>
            </StackPanel>
          </Grid>
        </Grid>
        <StackPanel x:Name="UpdateShell" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
          <Image x:Name="UpdateIcon" Width="77" Height="83" Margin="0,0,0,19" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock x:Name="UpdateHeading" Text="Launcher update required" Style="{StaticResource Heading}" TextAlignment="Center"/>
          <TextBlock x:Name="UpdateMessage" Text="Downloading the latest launcher…" Style="{StaticResource Hint}"
                     MaxWidth="495" TextAlignment="Center" Margin="0,8,0,16"/>
          <ProgressBar x:Name="UpdateProgress" Height="5" Width="190" IsIndeterminate="True" Foreground="{StaticResource Green}"
                       Background="#393B42" BorderThickness="0" HorizontalAlignment="Center"/>
          <Button x:Name="UpdateRetryButton" Style="{StaticResource Primary}" Content="Retry update" Width="149" Height="44"
                  HorizontalAlignment="Center" Margin="0,11,0,0" Visibility="Collapsed"/>
          <TextBlock Text="The launcher will restart. Your game files and saves will not be removed."
                     Style="{StaticResource Hint}" FontSize="12" TextAlignment="Center" Margin="0,13,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
